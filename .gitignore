# Raw CSV exports are regenerated on every pipeline run — never commit them
pipeline/*_recap_raw.csv

# Deputy shift-lead schedule export, regenerated each run (read-only input)
pipeline/deputy_schedule_raw.csv

# Expired Product Log export (Waste tab), regenerated each run (read-only input)
pipeline/expired_product_raw.csv
pipeline/expired_product_raw.md

# Intermediate per-shop JSON built on every run — regenerated, not source
pipeline/*_records_full_window.json

# Intermediate prepped CSV (e.g. OV shift-inference), regenerated each run
pipeline/*_recap_prepped.csv

# Raw HME reports fetched each run (plain-text email bodies hme_<store>.txt and
# PDF-extracted text hme_pdf_<store>.txt); the parsed result is committed in
# pipeline/hme_timer_history.json, so the raw bodies don't need to be tracked.
pipeline/hme_data/
pipeline/hme_*.txt
# 'checked, no report today' markers — ephemeral run signal, regenerated each run
pipeline/hme_*.none

# Python cache
__pycache__/
*.pyc
